      "description": "Private chat and coding agents over the on-box models, the shared wiki and the Onyx knowledge index.",
      "icon": "robot",
      "id": "agent-command",
      "name": "lightforce agent command",
      "scope": "private",
      "variables": [
        {
          "description": "64 hex chars encrypting conversation titles, messages and agent transcripts at rest. Generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\". Keep it: changing it makes existing conversations unreadable.",
          "label": "Chat encryption key",
          "name": "INDIECHAT_ENCRYPTION_KEY",
          "secret": true
        },
        {
          "description": "Enables web search for chat, agents and routines. Set here rather than in the app's own settings: a key entered there lives in one browser and never reaches agent turns. Leave empty to disable web search.",
          "label": "Web search key (Serper)",
          "name": "SERPER_KEY",
          "required": false,
          "secret": true
        },
        {
          "description": "Read token for the search app's /api/sources, used only to show which connectors feed the index on the Brain page. Leave empty to hide those figures.",
          "label": "Onyx search token",
          "name": "ONYX_SEARCH_TOKEN",
          "required": false,
          "secret": true
        }
      ],
