      "audience": [],
      "description": "One shared, private memory for all your AI agents over MCP, on the box's own models.",
      "icon": "brain",
      "id": "indie-brain",
      "name": "IndieBrain",
      "scope": "public",
      "variables": [
        {
          "description": "Password for the IndieBrain admin, who creates users and hands out their agents' API keys. Re-applied on every start, so changing it here takes effect after the app restarts.",
          "generate": "alnum:20",
          "label": "Admin password",
          "name": "INDIEBRAIN_ADMIN_PASSWORD",
          "secret": true
        },
        {
          "description": "Password of the app's internal PostgreSQL. Only you and the app ever need it; pick a long random one (Generate makes one). It is fixed when the database is first created, so do not change it afterwards.",
          "generate": "alnum:32",
          "label": "Database password",
          "name": "INDIEBRAIN_DB_PASSWORD",
          "secret": true
        },
        {
          "description": "Leave empty for: admin",
          "label": "Admin username",
          "name": "INDIEBRAIN_ADMIN_USERNAME",
          "required": false
        },
        {
          "description": "Which of the box's Ollama models extracts topics, people and action items from each thought. It has to be one the box has pulled (Admin > Models). Leave empty for: qwen3.6:35b",
          "label": "Model for auto-tagging",
          "name": "INDIEBRAIN_LLM_MODEL",
          "required": false
        },
        {
          "description": "Which of the box's Ollama models powers semantic search. It has to be pulled on the box and produce at least 1024 dimensions. Choose before storing memories: switching later makes existing memories unsearchable. Leave empty for: qwen3-embedding:8b",
          "label": "Embedding model",
          "name": "INDIEBRAIN_EMBEDDING_MODEL",
          "required": false
        },
        {
          "description": "Only to use models from somewhere other than this box. Leave empty for the box's own Ollama: http://ollama:11434",
          "label": "Ollama URL",
          "name": "INDIEBRAIN_OLLAMA_URL",
          "required": false
        }
      ],
      "versions": [
