    {
      "audience": [],
      "description": "Private chat, coding agents and a shared wiki over the box's own models.",
      "icon": "message-chatbot",
      "id": "indie-chat",
      "name": "indie.chat",
      "scope": "public",
      "variables": [
        {
          "description": "64 hex chars encrypting conversation titles, messages, agent transcripts and app state at rest. Press Generate to make one (without the button: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"). Keep it safe and keep it stable -- changing it makes everything already stored unreadable.",
          "generate": "hex:32",
          "label": "Encryption key",
          "name": "INDIE_CHAT_ENCRYPTION_KEY",
          "secret": true
        },
        {
          "description": "The first owner account, created on first boot. Without it the image seeds its DEVELOPMENT accounts, whose passwords are published in the source repo.",
          "label": "Admin email",
          "name": "INDIE_CHAT_ADMIN_EMAIL"
        },
        {
          "description": "Password for that first owner account. Only used on first boot; change it in the app afterwards.",
          "generate": "alnum:20",
          "label": "Admin password",
          "name": "INDIE_CHAT_ADMIN_PASSWORD",
          "secret": true
        },
        {
          "description": "Shown in the app for that account. Leave empty for: Admin",
          "label": "Admin display name",
          "name": "INDIE_CHAT_ADMIN_NAME",
          "required": false
        },
        {
          "description": "Which of the box's own Ollama models chat and the coding agents run on -- it has to be one the box has actually pulled. Leave empty for: qwen3.8:27b",
          "label": "Model",
          "name": "INDIE_CHAT_LLM_MODEL",
          "required": false
        },
        {
          "description": "Enables web search for chat, agents and routines. Set here rather than in the app's own settings: a key entered there lives in one browser and never reaches agent turns. Leave empty to disable web search.",
          "label": "Web search key (Serper)",
          "name": "INDIE_CHAT_SERPER_KEY",
          "required": false,
          "secret": true
        }
      ],
